# Aunoa WhatsApp Business API Configuration
# API Documentation: https://developers.aunoa.ai

# API Base URL
VITE_AUNOA_API_BASE=https://api.aunoa.ai/v1

# Authentication (Bearer token)
VITE_AUNOA_API_KEY=your-aunoa-api-key-here

# WhatsApp Sender ID (Bot phone number)
VITE_AUNOA_SENDER_ID=+34XXXXXXXXX
